[Unit]
Description=Grand Internet Hotel
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/grand-hotel-agents
Environment=HOTEL_DATA=/var/lib/grand-hotel-agents
Environment=PORT=8049
ExecStart=/usr/bin/python3 /opt/grand-hotel-agents/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/grand-hotel-agents
MemoryMax=192M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
